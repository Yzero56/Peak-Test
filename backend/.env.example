# backend/.env.example — copy to backend/.env and fill in real values. Never commit backend/.env.

# 관리자 대시보드 로그인 공용 비밀번호
ADMIN_PASSWORD=change-me

# 세션 쿠키 서명용 랜덤 문자열 (예: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-too

# SQLite 파일 DB 경로
DATABASE_URL=sqlite:///./fridge.db

# 업로드된 캡처 이미지 저장 경로
MEDIA_DIR=./media
