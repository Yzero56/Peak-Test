# backend/.env.example — copy to backend/.env and fill in real values. Never commit backend/.env.

# 모바일 앱 API 토큰 (X-App-Token 헤더로 사용)
ADMIN_PASSWORD=change-me

# SQLite 파일 DB 경로
DATABASE_URL=sqlite:///./fridge.db

# 업로드된 캡처 이미지 저장 경로
MEDIA_DIR=./media

# 식품안전나라 Open API 인증키 (조리식품 레시피 DB, COOKRCP01) — https://openapi.foodsafetykorea.go.kr
# 비워두면 추천 레시피는 앱의 목업 데이터로 폴백됨
FOOD_SAFETY_API_KEY=

# 3번 파트(kang) 백엔드 주소 — 관리자 대시보드의 "우리집 냉장고" 탭이 여기서 재고를 읽어옴
KANG_BACKEND_URL=https://antonym-tighten-backdrop.ngrok-free.dev

# "우리집 냉장고"의 BME 센서 보드가 kang에 데이터를 올릴 때 쓸 device_id.
# 보드 펌웨어의 device_id와 반드시 일치해야 센서값이 채워짐.
KANG_FRIDGE_DEVICE_ID=home-fridge-01
