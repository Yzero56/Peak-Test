// secrets.h.example — secrets.h로 복사한 뒤 실제 값을 채우세요.
// secrets.h는 커밋되지 않습니다 (.gitignore 참고).
#pragma once

#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// 백엔드 대시보드 "기기 등록" 화면에서 발급받은 값 (backend/README.md 참고)
#define DEVICE_ID     "fridge-01"
#define DEVICE_TOKEN  "여기에-발급받은-기기-토큰"

// 백엔드(FastAPI)가 실행 중인 PC의 LAN IP:포트.
// localhost/127.0.0.1이 아니라 같은 Wi-Fi에 있는 PC의 실제 IP를 적어야 ESP32에서 접근 가능합니다.
// (Windows: ipconfig에서 무선 LAN 어댑터의 IPv4 주소 확인)
#define BACKEND_BASE_URL "http://192.168.0.10:8000"
